# API
BIOLIFE_DB_URL=jdbc:postgresql://postgres:5432/biolife
BIOLIFE_DB_USER=biolife
BIOLIFE_DB_PASSWORD=
# Hisobotlar va rahbar boti (Telegram) — token bo'sh bo'lsa hisobot log'ga yoziladi, bot kutadi
BIOLIFE_REPORT_BOT_TOKEN=
BIOLIFE_REPORT_CHAT_ID=
# botdan so'ray oladigan rahbarlarning Telegram ID'lari (vergul bilan); hisobot chatlari ham avtomatik ruxsatli
BOT_ALLOWED_IDS=
# Demo seed (rahbar + 6 demo agent + 14 kun) — haqiqiy ma'lumot ulanganda false
BIOLIFE_SEED_ENABLED=false
BIOLIFE_SEED_MANAGER_PASSWORD=
# Kuzatuv ko'prigi (worker/kuzatuv_bridge) — haqiqiy faktlar; BRIDGE_USER ADMIN rolida bo'lishi kerak
BRIDGE_USER=kuzatuv-bridge
BRIDGE_PASS=
BRIDGE_API=http://127.0.0.1:8130
KUZATUV_DB=/home/ubuntu/kuzatuv/data/kuzatuv.sqlite
KUZATUV_ENV=/home/ubuntu/kuzatuv/.env
BRIDGE_SINCE=2026-09-29
BRIDGE_LOOKBACK_DAYS=10
BRIDGE_RADIUS_M=
BRIDGE_GRACE_MIN=30
BRIDGE_LOOSE_AFTER_MIN=120
BRIDGE_EVERY_SEC=300
# Suhbat yozuvlari (audio). Matn, ball va dalillar bazada qoladi; audio KEEP_DAYS kundan keyin o'chiriladi
BIOLIFE_RECORDINGS_DIR=/home/ubuntu/biolife-sales/data/recordings
BIOLIFE_RECORDINGS_KEEP_DAYS=180
# AI suhbat tahlili (worker/conversation_ai) — AI_WORKER_USER ADMIN rolida bo'lishi kerak
AI_WORKER_USER=ai-worker
AI_WORKER_PASS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_LANGUAGES=uz-UZ,ru-RU
LLM_GATEWAY_URL=http://127.0.0.1:4195
LLM_GATEWAY_TOKEN=
AI_MAX_PER_HOUR=60
